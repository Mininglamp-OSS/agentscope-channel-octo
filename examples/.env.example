# 复制为 .env 后填写（.env 已被 gitignore）
REDIS_URL=redis://localhost:6379/0

# 模型网关（OpenAI 兼容）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=your-model-name

# Octo IM 机器人：BotFather /newbot 生成的 token，API 地址形如 https://<host>/api
OCTO_API_URL=https://octo.example.com/api
OCTO_BOT_TOKEN=bf_xxx
